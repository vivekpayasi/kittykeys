// Shared build settings for every target.
// Personal values (signing team, bundle prefix) go in Local.xcconfig, which is
// gitignored. Copy Local.xcconfig.example to start one.

CATKEYS_BUNDLE_PREFIX = com.example
CATKEYS_APP_GROUP = group.$(CATKEYS_BUNDLE_PREFIX).catkeys

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 26.0

#include? "Local.xcconfig"
